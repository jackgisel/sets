{
  "name": "sets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate:local && vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply sets --local",
    "db:migrate:remote": "wrangler d1 migrations apply sets --remote",
    "deploy": "npm run build && wrangler deploy && npm run db:migrate:remote",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackgisel/sets.git"
  },
  "dependencies": {
    "hono": "^4.13.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
