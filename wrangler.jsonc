{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sets",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/openapi.json", "/llms.txt"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sets",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  // The jackgisel.com zone must be on Cloudflare; the custom domain and its certificate are created on deploy.
  "routes": [{ "pattern": "sets.jackgisel.com", "custom_domain": true }]
}
